<%- include('../partials/header') %>
<div class="wrap narrow" style="max-width:900px">
  <p class="small"><a href="/admin/emails">← Outbox</a></p>
  <div class="card">
    <div class="card-head" style="flex-direction:column;align-items:flex-start">
      <h2><%= e.subject %></h2>
      <div class="small muted">To <b><%= e.to_addr %></b> · <%= fmtDateTime(e.created_at) %> · <span class="badge <%= e.status === 'sent' ? 'tone-good' : e.status === 'failed' ? 'tone-bad' : 'tone-warn' %>"><%= e.status %></span><%= e.error ? ' · ' + e.error : '' %></div>
      <div class="btn-row mt"><% if (e.status !== 'sent' && smtpConfigured) { %><form method="post" action="/admin/emails/<%= e.id %>/send"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-primary">Send now</button></form><% } %><a class="btn btn-sm" href="mailto:<%= e.to_addr %>?subject=<%= encodeURIComponent(e.subject) %>">Open in my email client</a><span class="small muted">Tip: copy the content below into your email to send manually.</span></div>
    </div>
    <iframe src="/admin/emails/<%= e.id %>/raw" sandbox title="Email preview" style="width:100%;height:720px;border:0;background:#eef1f5"></iframe>
  </div>
</div>
<%- include('../partials/footer') %>
