<%- include('../partials/header') %>
<div class="auth-wrap">
  <%- include('../partials/auth-side') %>
  <section class="auth-main">
    <div class="auth-card">
      <h2>Sign in</h2>
      <p class="sub">Applicants and screening staff sign in here.</p>
      <%- include('../partials/flash') %>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form method="post" action="/login" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="next" value="<%= next %>">
        <div class="fld"><label for="email">Email address</label><input id="email" type="email" name="email" autocomplete="username" value="<%= values.email || '' %>" required autofocus></div>
        <div class="fld"><label for="password">Password</label><input id="password" type="password" name="password" autocomplete="current-password" required></div>
        <button class="btn btn-primary btn-lg btn-block">Sign in</button>
      </form>
      <div class="btn-row mt" style="justify-content:space-between">
        <a href="/forgot" class="small">Forgotten your password?</a>
        <a href="/register" class="small">New applicant? Create an account</a>
      </div>
    </div>
  </section>
</div>
<%- include('../partials/footer') %>
