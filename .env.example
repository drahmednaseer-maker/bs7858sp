# Copy to .env for local use. On Railway, set these as service Variables.

NODE_ENV=production
PORT=3000
# Public URL of the app (used in emails and referee links)
APP_URL=https://onboarding.securityprojects.uk

# Persistent storage – on Railway mount a Volume at /data and set:
DATA_DIR=/data

# 32-byte base64 key used to encrypt all application data and uploaded files at rest.
# Generate once:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEEP IT SAFE – losing it makes stored data unreadable. Never change it after go-live.
ENCRYPTION_KEY=
SESSION_SECRET=

# Super admin seeded on first start (change the password after first sign-in)
ADMIN_EMAIL=admin@securityprojects.uk
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin

# Company contact shown to applicants and used for notifications
COMPANY_EMAIL=info@securityprojects.uk
COMPANY_PHONE=0303 003 2135
COMPANY_VAT=

# Outgoing email (Microsoft 365 example). Leave SMTP_HOST empty to store emails in the admin Outbox instead.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Security Projects Screening <info@securityprojects.uk>

# BS 7858 gap threshold in days (history gaps of this length or more must be explained)
SCREENING_GAP_DAYS=28
